# Copy the full Supabase Connect > Transaction pooler URI; do not guess the pooler host.
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are REST API credentials; Drizzle/pg still needs this database URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ISPATLA_SECRET_KEY=replace-with-a-separate-random-vault-key
ISPATLA_TOKEN_KEY_CURRENT=replace-with-a-separate-random-token-key
ISPATLA_PRIVATE_BETA=1
ISPATLA_AUTOMATION=0
# Optional normal-runtime provider configuration (demo requires none):
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=
# X login callback registered in the X Developer Console:
# http://localhost:3000/api/auth/callback/twitter (production: https://ispatla.tr/api/auth/callback/twitter)
# X_OAUTH_REDIRECT_URI=http://localhost:3000/api/x/oauth/callback
# ISPATLA_MAIL_API_URL=
# ISPATLA_MAIL_API_TOKEN=
